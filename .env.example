# Public app URL used for Supabase password reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Preferred public key variable.
# If Supabase shows a "publishable" key in the dashboard, put that value here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional fallback supported by the runtime helper.
# Leave blank unless you intentionally use Supabase's publishable-key naming.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Project Settings > API > service_role key.
# Server-only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random chars. Used server-side to encrypt the Gemini API key before storing it.
# Example generator: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional local reference only. Runtime Gemini settings are saved from /owner.
GEMINI_API_KEY=

# Optional: used by `npm run seed:owner` to create/seed the first owner.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_FULL_NAME=Owner
OWNER_DAILY_USAGE_LIMIT=1000

# Optional: use this instead of OWNER_PASSWORD if the auth user already exists.
OWNER_USER_ID=
